{
  "name": "indicvoice-lab-server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "benchmark": "node ./scripts/runBenchmark.js --manifest ./benchmarks/manifest.json --report ./benchmarks/reports/latest-report.json",
    "benchmark:live": "node ./scripts/runBenchmark.js --live --manifest ./benchmarks/manifest.json --report ./benchmarks/reports/latest-report.json"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "form-data": "^4.0.0",
    "multer": "^2.0.2",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
