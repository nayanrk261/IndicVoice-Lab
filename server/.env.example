PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Gnani Prisma configuration
GNANI_API_KEY_ID=
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_STT_PATH=/stt/v3
GNANI_AUDIO_FIELD_NAME=audio_file
GNANI_LANGUAGE_CODE=hi-IN
GNANI_PREFERRED_LANGUAGE=hi-IN
GNANI_FORMAT=transcribe
GNANI_ITN_NATIVE_NUMERALS=true
GNANI_API_TIMEOUT_MS=120000
GNANI_ALLOWED_MIME_TYPES=audio/wav,audio/mpeg,audio/mp4,audio/x-wav,audio/flac,audio/ogg
GNANI_MAX_AUDIO_SIZE_BYTES=26214400
TEMP_UPLOAD_DIR=./tmp


